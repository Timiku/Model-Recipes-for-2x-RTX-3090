# qwen3.8-27b / superfast — MACHINE delta (this box's own copy of the tier).
#
# Read at boot (up.sh) and passed to compose:
#   docker compose --env-file superfast.env -f package/superfast.yml
# A key here differs from the package default; a blank value
# falls through to the package default. The file is plain
# KEY=value (docker compose .env format), shell-sourceable.
#
# The WIZARD owns this file. On a package update it prompts keep-or-reset for
# the machine settings (device pair, bind, the ctx/concurrency shape, the
# dirs); a package reinstall re-applies package/ but NEVER resets this file.
# WEIGHTS_DIR is user property and is never touched.
#
# Seeded with the package defaults so a first boot is well-defined before the
# wizard runs; edit a line to change it.
# blank = the model's own weights/ folder
WEIGHTS_DIR=
TARGET_MODEL=qwen3.8-27b-autoround-int4
DRAFTER_MODEL=qwen3.8-27b-dflash2-w4a16
# which two cards (PCI bus order)
DEVICE_PAIR="0,1"
# 127.0.0.1 = loopback only; 0.0.0.0 = every iface
BIND_HOST=0.0.0.0
PORT=8104
MAX_MODEL_LEN=262144
GPU_MEMORY_UTILIZATION=0.90
MAX_NUM_SEQS=1
MAX_NUM_BATCHED_TOKENS=8192
KV_CACHE_DTYPE=fp8_e4m3
W4A8=1
SPEC_N=7
ENABLE_THINKING=true
REASONING_EFFORT=low
CHAT_TEMPLATE=
TEMP=
TOP_P=
TOP_K=
MIN_P=
PRESENCE_PENALTY=
