# qwen3.8-27b / kvarnmtp — MACHINE delta (this box's own copy of the tier).
#
# Read at boot (up.sh) and passed to compose:
#   docker compose --env-file kvarnmtp.env -f package/kvarnmtp.yml
# A key here differs from the package default; a blank value
# falls through to the package default. The file is plain
# KEY=value (docker compose .env format), shell-sourceable.
# Only a key present here overrides the package template. The WIZARD owns this
# file; WEIGHTS_DIR is user property, never touched. Seeded with the package
# defaults.
#
# kvarnmtp = the MTP shape (built-in drafter at n=4) on KVarN int4 KV. Port
# 8116, SHARED with kvarntier.yml's shape: the two are mutually exclusive
# (same cards), so exactly one of them runs at a time — that is the fp8 lane's
# mtp/nomtp arrangement. Measured 09-14: pool 1,113,340 with the drafter,
# n=2/4/8 = 47.6/59.7/60.8 tok/s, acceptance at fp8 parity, +0.5% PPL.
# blank = the model's own weights/ folder
WEIGHTS_DIR=
TARGET_MODEL=qwen3.8-27b-autoround-int4
# which two cards (PCI bus order)
DEVICE_PAIR="0,1"
# 127.0.0.1 = loopback only; 0.0.0.0 = every iface
BIND_HOST=0.0.0.0
PORT=8116
MAX_MODEL_LEN=262144
GPU_MEMORY_UTILIZATION=0.90
MAX_NUM_SEQS=4
MAX_NUM_BATCHED_TOKENS=4096
LONG_PREFILL_TOKEN_THRESHOLD=4096
KV_CACHE_DTYPE=kvarn_k4v2_g128
BLOCK_SIZE=128
MAMBA_CACHE_MODE=align
PREFIX_MATCH_UNIT=16
# first boot keeps the sweep value; 0 is the fallback arm
MAMBA_BLOCK_SIZE=8192
W4A8=1
# the tier's whole identity: built-in MTP at n=4 (0 = kvarntier's shape)
SPEC_N=4
ENABLE_THINKING=true
REASONING_EFFORT=low
CHAT_TEMPLATE=
TEMP=
TOP_P=
TOP_K=
MIN_P=
PRESENCE_PENALTY=
