# qwen3.8-27b / nomtp — MACHINE delta (this box's own copy of the tier).
#
# Read at boot (up.sh) and passed to compose:
#   docker compose --env-file nomtp.env -f package/nomtp.yml
# A key here differs from the package default; a blank value
# falls through to the package default. The file is plain
# KEY=value (docker compose .env format), shell-sourceable.
# Only a key present here overrides the package template. The WIZARD owns this
# file: on a package update it prompts keep-or-reset for the machine settings; a
# package reinstall re-applies package/ but never resets this. WEIGHTS_DIR is
# user property, never touched. Seeded with the package defaults.
#
# nomtp = the drafter-OFF shape of the dual-fast slot (SPEC_N 0); the mtp sibling
# is the same slot with the built-in MTP head at n=4. Both share port 8113 and
# are mutually exclusive.
# blank = the model's own weights/ folder
WEIGHTS_DIR=
TARGET_MODEL=qwen3.8-27b-autoround-int4
# which two cards (PCI bus order)
DEVICE_PAIR="0,1"
# 127.0.0.1 = loopback only; 0.0.0.0 = every iface
BIND_HOST=0.0.0.0
PORT=8113
MAX_MODEL_LEN=262144
GPU_MEMORY_UTILIZATION=0.90
MAX_NUM_SEQS=2
MAX_NUM_BATCHED_TOKENS=4096
LONG_PREFILL_TOKEN_THRESHOLD=4096
KV_CACHE_DTYPE=fp8_e4m3
MAMBA_CACHE_MODE=align
PREFIX_MATCH_UNIT=16
W4A8=1
# drafter OFF — this tier's identity
SPEC_N=0
ENABLE_THINKING=true
REASONING_EFFORT=low
CHAT_TEMPLATE=
TEMP=
TOP_P=
TOP_K=
MIN_P=
PRESENCE_PENALTY=
