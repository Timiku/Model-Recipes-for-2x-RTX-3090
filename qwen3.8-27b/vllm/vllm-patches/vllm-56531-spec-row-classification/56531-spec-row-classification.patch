+def compute_num_decode_draft_tokens(
+    num_reqs: int,
+    num_scheduled_tokens: np.ndarray,
+    num_draft_tokens_per_req: np.ndarray | None,
+    is_prefilling_np: np.ndarray,
+) -> np.ndarray:
+    """Number of draft tokens each row must take through the speculative
+    path this step, or -1 for a row that takes the plain decode path.
+
+    The recurrent state of a row on the speculative path is read at an
+    accepted-token offset that the plain decode path does not apply. A row
+    that could draft at all but drafted nothing this step must therefore
+    stay on the speculative path with a zero draft count: only that path
+    restores the state consistency. A prompt chunk is different: its tokens
+    are prompt tokens and carry no accepted-token offset, so it takes the
+    plain path with the -1 sentinel. (vLLM PR #56531)
+    """
+    num_decode_draft_tokens_np = np.full(num_reqs, -1, dtype=np.int32)
+    if num_draft_tokens_per_req is None:
+        return num_decode_draft_tokens_np
+    if len(num_draft_tokens_per_req) > num_reqs:
+        num_draft_tokens_per_req = num_draft_tokens_per_req[:num_reqs]
+    is_decode = num_scheduled_tokens[:num_reqs] == num_draft_tokens_per_req + 1
+    spec_decode_mask = (num_draft_tokens_per_req > 0) & is_decode
+    num_decode_draft_tokens_np[:num_reqs] = np.where(
+        spec_decode_mask, num_draft_tokens_per_req, -1
+    )
+    return num_decode_draft_tokens_np
+
