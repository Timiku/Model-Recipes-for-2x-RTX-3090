# qwen3.8-27b / kvarndflash2 — MACHINE delta (this box's own copy of the tier).
#
# Read at boot (up.sh) and passed to compose:
#   docker compose --env-file kvarndflash2.env -f package/kvarndflash2.yml
# A key here differs from the package default; a blank value
# falls through to the package default. The file is plain
# KEY=value (docker compose .env format), shell-sourceable.
# Only a key present here overrides the package template. The WIZARD owns this
# file; WEIGHTS_DIR is user property, never touched. Seeded with the package
# defaults.
#
# kvarndflash2 = DFlash2 EXTERNAL drafter n=7 on KVarN int4 KV. Own port 8117;
# mutually exclusive with every other tier (both cards). UNVALIDATED: this is
# the arm that asks whether the fast drafter survives 4-bit KV, so the first
# boot's pool line, the drafter-attach line and the draft acceptance are the
# verdict. The drafter's sliding-window layers stay in the native dtype (the
# bundle's install-dflash2.sh), so only the target's full-attention layers are
# quantized.
# blank = the model's own weights/ folder
WEIGHTS_DIR=
TARGET_MODEL=qwen3.8-27b-autoround-int4
DRAFTER_MODEL=qwen3.8-27b-dflash2-w4a16
# which two cards (PCI bus order)
DEVICE_PAIR="0,1"
# 127.0.0.1 = loopback only; 0.0.0.0 = every iface
BIND_HOST=0.0.0.0
PORT=8117
MAX_MODEL_LEN=262144
GPU_MEMORY_UTILIZATION=0.90
# VRAM, not a DFlash2 limit: the drafter's
MAX_NUM_SEQS=1
MAX_NUM_BATCHED_TOKENS=8192
LONG_PREFILL_TOKEN_THRESHOLD=4096
KV_CACHE_DTYPE=kvarn_k4v2_g128
# one block = one KVarN tile
BLOCK_SIZE=128
MAMBA_CACHE_MODE=align
PREFIX_MATCH_UNIT=16
# the 09-14 sweep value; 0 is the fallback arm
MAMBA_BLOCK_SIZE=8192
W4A8=1
# the DFlash2-EXTERNAL contract
SPEC_N=7
ENABLE_THINKING=true
REASONING_EFFORT=low
CHAT_TEMPLATE=
TEMP=
TOP_P=
TOP_K=
MIN_P=
PRESENCE_PENALTY=
