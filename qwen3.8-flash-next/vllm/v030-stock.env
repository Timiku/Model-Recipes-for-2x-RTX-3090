# v030-stock.env - Step 1 of the Stage-2 review: plain vllm/vllm-openai:v0.30.0-cu129,
# NO vendor overlay, nomtp semantics via the entrypoint (stock image = vllm CLI,
# no qwen38-serve wrapper, so MTP_DEPTH is ours to control), on the good pair.
# User-gated boot only. Serves on port 8119.
WEIGHTS_DIR=
TARGET_MODEL=qwen3.8-flash-next
SERVED_MODEL_NAME=qwen3.8-flash-next
DEVICE_PAIR="0,2"
PORT=8119
MAX_MODEL_LEN=256000
KV_CACHE_MEMORY_BYTES=4429185024
CPU_OFFLOAD_GB=30
MAX_NUM_BATCHED_TOKENS=4096
MAX_NUM_SEQS=1
MTP_DEPTH=0
ENABLE_VISION=0
VLLM_IMAGE=vllm/vllm-openai:v0.30.0-cu129
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:False
VLLM_WSL2_ENABLE_PIN_MEMORY=1
VLLM_PLE_DISK_OFFLOAD_DIR=/ple-table
