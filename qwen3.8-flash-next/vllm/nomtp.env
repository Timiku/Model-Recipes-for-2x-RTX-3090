# qwen3.8-flash-next / nomtp — MACHINE delta (this box's own copy of the tier).
#
# Read at boot (up.sh) and passed to compose:
#   docker compose --env-file nomtp.env -f package/nomtp.yml
# A key here differs from the package default; a blank value
# falls through to the package default. The file is plain
# KEY=value (docker compose .env format), shell-sourceable.
# Only a key present here overrides the package template (and its value is
# also what the package template's ${VAR:-...} forms interpolate to). The
# WIZARD owns this file: a package reinstall re-applies package/ but never
# resets this. WEIGHTS_DIR is user property, never touched.
#
# The values are the box's C4 rung (2026-09-16, user call): the t20 shape
# with the window re-anchored to the community issue-#2 line - a 256,000-token
# window. The KV pool is the vendor's validated 2x3090 constant
# (4,429,185,024 B = 275,801 tokens = 1.08x the window), identical to the mtp
# tier - pool==window starves the boundary/long shapes of admission slack even
# at K=0 (prompt+output must fit alongside the block rounding); the
# drafter-off stance stands (depth 0, the wrapper skips the speculative
# config, retention 1600). The 84-slot hot
# cache is the re-pin's safe default (88 can OOM the QSA prefill scratch at
# the window edge). The proven chain + the 35 tok/s measurement stand behind
# these values.
# blank = the model's own weights/ folder
WEIGHTS_DIR=
TARGET_MODEL=qwen3.8-flash-next
SERVED_MODEL_NAME=qwen3.8-flash-next
# this box: card 1 is the display card
DEVICE_PAIR="0,2"
PORT=8116
MAX_MODEL_LEN=256000
KV_CACHE_MEMORY_BYTES=4429185024
CPU_OFFLOAD_GB=30
VLLM_WNA16_STATIC_HOT_CACHE_SIZE=84
MAX_NUM_BATCHED_TOKENS=4096
MAX_NUM_SEQS=1
MTP_DEPTH=0
VLLM_PREFIX_CACHE_RETENTION_INTERVAL=1600
VLLM_PLE_DISK_OFFLOAD_DIR=/ple-table
ENABLE_VISION=1
VISION_MAX_IMAGES=1
VISION_MAX_PIXELS=1048576
VLLM_WSL2_ENABLE_PIN_MEMORY=1
SAMPLER=card
TEMP=
TOP_P=
TOP_K=
MIN_P=
PRESENCE_PENALTY=
UP_PROBE_TIMEOUT=3600
