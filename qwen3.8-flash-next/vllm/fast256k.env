# qwen3.8-flash-next / fast256k — the fast-256k profile as a tracked tier delta.
#
# Read at boot (up.sh) and passed to compose:
#   docker compose --env-file fast256k.env -f package/nomtp.yml
# Created 2026-09-28 for the upstream-adoption plan Stage 1 addendum: their
# configs/fast-256k.env knobs (GHCR dominikbucko v0.3.0) benchmarked on this
# rig before the .57 native comparison. MTP-draft-vocab knob is deliberately
# MTP stays ON for this profile: their entrypoint unconditionally passes the
# speculative config, and the draft-vocab restriction is part of the profile.
# (Earlier MTP hangs here were the 0,1 display-card pair regression, not MTP
# itself - see the t34 bench-log entry; MTP measures 36.9 tok/s on 0,2.)
#
# DISABLE_CUSTOM_ALL_REDUCE=1 until the rig proves P2P with
# scripts/check_custom_all_reduce.py; flip to 0 (their value) after.
WEIGHTS_DIR=
TARGET_MODEL=qwen3.8-flash-next
SERVED_MODEL_NAME=qwen3.8-flash-next
DEVICE_PAIR="0,1"
PORT=8117
MAX_MODEL_LEN=256000
KV_CACHE_MEMORY_BYTES=4429185024
CPU_OFFLOAD_GB=30
VLLM_WNA16_STATIC_HOT_CACHE_SIZE=84
MAX_NUM_BATCHED_TOKENS=4096
MAX_NUM_SEQS=1
MTP_DEPTH=3
VLLM_MTP_DRAFT_VOCAB_RANGES=[[0,65536],[248044,248320]]
VLLM_PREFIX_CACHE_RETENTION_INTERVAL=1600
VLLM_PLE_DISK_OFFLOAD_DIR=/ple-table
ENABLE_VISION=1
# --- the fast-256k profile knobs (their values) ---
QWEN38_STREAM_STAGE=1
QWEN38_STREAM_STAGE_MIN_TOKENS=1536
QWEN38_STAGE_OVERLAP=1
QWEN38_ASYNC_SCHEDULING=1
QWEN38_TRITON_SKINNY=1
QWEN38_PLE_PREFAULT=1
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:False
DISABLE_CUSTOM_ALL_REDUCE=1
