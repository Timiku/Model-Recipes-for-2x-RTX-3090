# gemma4-31b / gemma-dual (MTP-on) — MACHINE delta (this box's own copy).
#
# Read at boot (up.sh) and passed to compose:
#   docker compose --env-file gemma-dual.env -f package/gemma-dual.yml
# A key here differs from the package default; a blank value
# falls through to the package default. The file is plain
# KEY=value (docker compose .env format), shell-sourceable.
# Only a key present here overrides the package template. The WIZARD owns this
# file: on a package update it prompts keep-or-reset for the machine settings; a
# package reinstall re-applies package/ but never resets this. WEIGHTS_DIR is user
# property, never touched. Values below are this box's proven ones (from the
# pre-rebase config file), re-based onto 0.29.0.
# blank = the model's own weights/ folder
WEIGHTS_DIR=
TARGET_MODEL=gemma-4-31b-qat-awq-int4
DRAFTER_MODEL=gemma-4-31b-it-assistant
# which two cards (PCI bus order)
DEVICE_PAIR="0,1"
# 127.0.0.1 = loopback only; 0.0.0.0 = every iface
BIND_HOST=0.0.0.0
PORT=8032
MAX_MODEL_LEN=179040
GPU_MEMORY_UTILIZATION=0.9390
MAX_NUM_SEQS=2
MAX_NUM_BATCHED_TOKENS=4096
# sm_86 has no fp8 KV kernel; auto = bf16
KV_DTYPE=auto
# MTP-on tier: the assistant's proven arm (0 = off)
SPEC_N=2
TP=2
PP=1
TEMP=1.0
TOP_P=0.95
TOP_K=64
MIN_P=0.0
REPEAT_PENALTY=1.0
# blank = the vendored Google-canonical template
CHAT_TEMPLATE=
